# ~/SharpLab/.env.wall on the homelab (never commit the real one)
WALL_API_TOKEN=change-me-long-random
# WALL_STATE_DIR=/home/davidj/.local/state/sharplab-wall
# WALL_IMPORT_FROM=/home/davidj/.local/state/tv/wall.json   # first start imports the TV's presets
# WALL_IDLE_S=600            # stop the Discord wall this long after the last viewer
# WALL_FIRST_VIEWER_S=900    # … or this long after start with nobody at all
# WALL_MAX_HOURS=6
# WALL_MIN_FREE_MB=2500      # refuse to start the Discord wall with less free VRAM
# WALL_MIN_FREE_MB=2500      # counted after the LLM guard unloaded Ollama's models
# WALL_TV_OUTPUT=HDMI-A-1    # mirror mode streams this output of the TV ("" = copy it with tiles instead)
# WALL_TV_SINK=              # … with this sink's sound ("" = the default sink)
# WALL_MAX_LOAD=16           # refuse / auto-stop (after 30 s) the Discord wall past this 1-min load average …
# WALL_MIN_AVAIL_MB=3072     # … or under this much available memory
# WALL_OLLAMA_URL=http://127.0.0.1:11434
# WALL_LLM_GUARD=unload      # unload | stop (needs deploy/ollama-wall.polkit.rules) | off
# The watch party's chat on the TV wall (wall/chat.py). All three set = on; otherwise no chat on the TV.
# WALL_WEB_URL=http://100.81.31.34:8796   # sharplab-web over Tailscale (deploy/caddy-wall.snippet: the tailnet-only listener)
# WALL_WEB_KEY=…                          # = WEB_API_SECRET on the VPS
# WALL_OWNER_ID=…                         # = WALL_OWNER_ID on the VPS: the TV's phones post as him
# WALL_OWNER_NAME=David
# Bets on the wall + the spoiler delay (wall/sync.py, wall/bets.py). The bets feed uses WALL_WEB_URL / WALL_WEB_KEY above.
# WALL_BETS_DELAY_S=45       # how far behind real life a tile is assumed to be until its scorebug is read (or it's set by hand)
# WALL_SYNC_OCR=1            # 0 = don't read the tiles' scorebugs (~0.3–1 core while a live wall runs); manual + default only
