# The Odds API — https://the-odds-api.com
ODDS_API_KEY=your_key_here

# Kalshi — https://kalshi.com/api
KALSHI_API_KEY=your_key_here

# balldontlie — https://www.balldontlie.io
BALLDONTLIE_API_KEY=your_key_here

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Discord bot
DISCORD_BOT_TOKEN=your_token_here
# Right-click your server → Copy Server ID (requires Developer Mode in Discord settings)
DISCORD_GUILD_ID=your_guild_id_here

# === Discord channels ===
# Channel ID for bot logs (WARNING+ level). Right-click channel → Copy Channel ID.
LOG_CHANNEL_ID=
# Channel for auto CLV posts after game closes
CLV_CHANNEL_ID=
# Channel for injury update announcements
INJURY_CHANNEL_ID=
# Channel for bet digest / daily summary (falls back to INJURY_CHANNEL_ID if unset)
BET_DIGEST_CHANNEL_ID=
# Error alerting — channel for error alert embeds
ERROR_ALERT_CHANNEL_ID=
# Thread ID for persistent error log mirror (created automatically if empty)
ERROR_LOG_THREAD_ID=
# Channel for Sentinel error forwarding (deduped, classified, ticketed)
SENTINEL_ERROR_FORWARD_CHANNEL_ID=
# Automated sports-news poster — channel for major NBA/NFL/MLB headlines (pings league roles)
SPORTS_NEWS_CHANNEL_ID=
# Chess blunder alerts channel (Norway Chess live analysis)
CHESS_BLUNDER_CHANNEL_ID=
# Deploy announcements channel — where announce_deploy.py posts update messages
UPDATE_ANNOUNCE_CHANNEL_ID=
# Comma-separated channel IDs where /bet log NLP is active
BET_NLP_CHANNEL_IDS=

# === Web server ===
# Shared secret between bot cogs and web API for internal game requests
WEB_API_SECRET=dev-secret
# Starlette session signing key (falls back to WEB_API_SECRET if unset)
SESSION_SECRET=
# Public base URL of the web server
WEB_BASE_URL=https://sharplab.djiang.xyz
# DB path for the web server (default: data/sharplab.db relative to CWD)
SHARPLAB_DB_PATH=data/sharplab.db
# Discord OAuth2 for web login — https://discord.com/developers/applications
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# Discord user ID to grant owner-level web access
OWNER_DISCORD_ID=
# Chess API base URL for HQ chess page
CHESS_API_BASE=https://games.djiang.xyz/chess/api

# === Chess blunder engine ===
# Path to stockfish binary on the VPS (default: "stockfish" on PATH)
STOCKFISH_PATH=/usr/games/stockfish
# Seconds per position for stockfish eval (default: 0.4)
CHESS_BLUNDER_EVAL_TIME=0.4
